[MITM]
hostname=%APPEND% api.revenuecat.com,api.rc-backup.com,firebaseremoteconfig.googleapis.com,api.locketcamera.com

[Script]

# Locket
Revenuecat=type=http-response,pattern=https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/rin/refs/heads/json/locket.js
DeleteHeader=type=http-request,pattern=https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/rin/refs/heads/json/deleteheader.js
RemoteConfig=type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,requires-body=true,timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/rin/refs/heads/json/remoteconfig.js
